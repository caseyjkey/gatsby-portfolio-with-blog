---
import BaseLayout from '../layouts/BaseLayout.astro';
import NavBar from '../components/Navigation/NavBar';
import HeroSection from '../components/Introduction/HeroSection';
import SkillsSection from '../components/Skills/SkillsSection';
import ExperienceTimeline from '../components/Experience/ExperienceTimeline';
import ProjectCards from '../components/Projects/ProjectCards';
import FooterSection from '../components/Footer/FooterSection';
import { regionalProfiles } from '../data/regionalProfiles';
import { getProjects } from '../lib/projects';

const regionalFeaturedSlugs = new Set(
  regionalProfiles.flatMap((profile) => profile.featuredProjectSlugs),
);
const projects = getProjects().filter((project) => (
  project.konamiOnly || regionalFeaturedSlugs.has(project.slug)
));
---

<BaseLayout>
  <NavBar client:load pathname={Astro.url.pathname} />
  <HeroSection client:load />
  <SkillsSection client:visible={{ rootMargin: '-100px' }} />
  <ExperienceTimeline client:visible={{ rootMargin: '-100px' }} />
  <ProjectCards
    client:idle={{ timeout: 2000 }}
    projects={projects}
    title="Featured Work"
    subtitle="Highlighted projects from my portfolio."
    variant="featured"
  />
  <FooterSection />
</BaseLayout>
