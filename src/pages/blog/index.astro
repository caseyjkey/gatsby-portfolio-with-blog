---
import { getCollection } from 'astro:content';
import { format } from 'date-fns';
import NavBar from '../../components/Navigation/NavBar';
import FooterSection from '../../components/Footer/FooterSection';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { extractPreview } from '../../lib/content';

const blogPosts = await getCollection('blog', ({ data }) => data.published);
const projectPosts = await getCollection('projects', ({ data }) => data.published);
const posts = [...blogPosts, ...projectPosts]
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .map((post) => ({
    ...post,
    href: `/${post.collection}/${post.id.replace(/\/index$/, '')}/`,
    preview: extractPreview(post.body ?? '', 250),
  }));
---

<BaseLayout pathname="/blog" title="Blog | Casey Key">
  <NavBar client:only="react" />
  <main class="blog-page">
    <div class="container">
      <section class="hero">
        <h1>Blog</h1>
        <p>Coding, reflecting, evolving.</p>
      </section>
      <section class="list">
        {posts.map((post) => (
          <article class="post-entry">
            <a href={post.href} class="post-link">
              <h2>{post.data.title}</h2>
              <p class="date">{format(post.data.date, 'yyyy MMMM do')}</p>
              <p class="excerpt">{post.preview}</p>
            </a>
          </article>
        ))}
      </section>
    </div>
  </main>
  <FooterSection client:only="react" />
</BaseLayout>

<style>
  .blog-page {
    margin-top: 6em;
  }

  .hero {
    text-align: center;
    padding-top: 3rem;
    padding-bottom: 3rem;
  }

  .hero h1 {
    color: #000;
    font-size: 50px;
    line-height: 1.5;
    font-weight: 700;
    margin: 0 0 1.5rem;
  }

  .hero p {
    color: rgba(0, 0, 0, 0.6);
    margin: 0 0 1rem;
  }

  .post-entry {
    padding-bottom: 2rem;
    margin-bottom: 1.5rem;
  }

  .post-entry:last-child {
    padding-bottom: 1rem;
    margin-bottom: 0;
  }

  .post-link {
    display: block;
    text-decoration: none;
    color: inherit;
  }

  .post-link h2 {
    color: #000;
    font-size: 40px;
    line-height: 1.5;
    font-weight: 400;
    margin: 0 0 0.5rem;
  }

  .date {
    color: var(--color-primary);
    font-weight: 400;
    margin: 0 0 1rem;
  }

  .excerpt {
    color: #000;
    margin: 0 0 1rem;
  }

  @media (max-width: 767.98px) {
    .hero h1 { font-size: 38px; }
    .post-link h2 { font-size: calc(1.375rem + 1.5vw); }
  }
</style>
