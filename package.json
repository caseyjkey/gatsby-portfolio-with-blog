{
  "name": "portfolio-app",
  "version": "0.1.0",
  "private": true,
  "homepage": "https://caseyjkey.github.io/",
  "dependencies": {
    "date-fns": "^4.1.0",
    "gh-pages": "^4.0.0",
    "motion": "^12.25.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-icons": "^5.5.0",
    "sass": "^1.56.2",
    "typewriter-effect": "^2.21.0"
  },
  "scripts": {
    "dev": "astro dev --host --port 8001 2>&1 | tee /tmp/astro-dev.log",
    "dev:no-logs": "astro dev --host --port 8001",
    "dev:status": "bash scripts/dev-status.sh",
    "dev:logs": "tail -100 /tmp/astro-dev.log 2>/dev/null || echo 'No log file found. Start dev server first'",
    "dev:errors": "grep -i 'error' /tmp/astro-dev.log 2>/dev/null | tail -20 || echo 'No log file found. Start dev server first'",
    "start": "astro dev --host --port 8001",
    "build": "astro build",
    "serve": "astro preview --host --port 8001",
    "clean": "rm -rf dist .astro",
    "deploy": "bun run build && gh-pages -d dist -b master"
  },
  "eslintConfig": {
    "extends": "react-app"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.8",
    "@astrojs/mdx": "^5.0.3",
    "@astrojs/react": "^5.0.3",
    "@types/node": "^22.10.5",
    "@types/react": "^19.0.4",
    "@types/react-dom": "^19.0.2",
    "astro": "^6.1.8",
    "bun-types": "^1.3.12",
    "typescript": "^5.7.3"
  }
}
